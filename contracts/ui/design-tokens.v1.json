{
  "version": "1.0",
  "status": "baseline",
  "principles": {
    "base_unit_px": 4,
    "wcag_target": "2.2 AA",
    "default_density": "comfortable-dense",
    "color_only_meaning_forbidden": true,
    "vendor_tokens_in_product_ui_forbidden": true
  },
  "spacing_px": {
    "xs": 4,
    "sm": 8,
    "md": 12,
    "lg": 16,
    "xl": 24,
    "2xl": 32,
    "3xl": 48,
    "4xl": 64
  },
  "radius_px": {
    "sm": 6,
    "md": 8,
    "lg": 12,
    "pill": 999
  },
  "layout": {
    "nav_expanded_px": 240,
    "nav_collapsed_px": 64,
    "context_rail_min_px": 320,
    "context_rail_max_px": 400,
    "page_padding_desktop_px": 24,
    "collapse_nav_below_px": 1024,
    "overlay_context_rail_below_px": 1280
  },
  "density": {
    "comfortable-dense": {
      "table_row_px": 40,
      "control_min_px": 36,
      "toolbar_px": 40,
      "card_padding_px": 16
    },
    "compact": {
      "table_row_px": 34,
      "control_min_px": 32,
      "toolbar_px": 34,
      "card_padding_px": 12
    }
  },
  "typography": {
    "font_sans": [
      "Inter",
