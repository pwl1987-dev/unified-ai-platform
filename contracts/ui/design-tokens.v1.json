      "PingFang SC",
      "Microsoft YaHei",
      "system-ui",
      "sans-serif"
    ],
    "font_mono": [
      "ui-monospace",
      "SFMono-Regular",
      "Consolas",
      "Liberation Mono",
      "monospace"
    ],
    "scale": {
      "page_title": {
        "size_px": 24,
        "line_px": 32,
        "weight": 600
      },
      "section_title": {
        "size_px": 18,
        "line_px": 28,
        "weight": 600
      },
      "subsection": {
        "size_px": 16,
        "line_px": 24,
        "weight": 600
      },
      "body": {
        "size_px": 14,
        "line_px": 22,
        "weight": 400
      },
      "body_strong": {
        "size_px": 14,
        "line_px": 22,
        "weight": 600
      },
      "metadata": {
        "size_px": 13,
        "line_px": 20,
        "weight": 400
      },
      "caption": {
        "size_px": 12,
        "line_px": 18,
        "weight": 400
      }
    }
  },
